# Root containing project directories used by cproj and oproj.
export DEV_WORKPLACE="$HOME/Workplace"

# Executable used to open projects and files.
export DEV_EDITOR="code"

# Optional. Defaults to a sibling .worktrees directory near the repository.
# export DEV_WORKTREE_ROOT="$HOME/Worktrees"

# Obsidian vault name or vault ID. Leave empty to use the active vault.
export DEV_OBSIDIAN_VAULT=""

# Optional filesystem path used by the cvault shell shortcut.
# export DEV_OBSIDIAN_VAULT_PATH="$HOME/Documents/Obsidian/My Vault"

# Interactive AI command and optional stdin-based review/resume commands.
export DEV_AI_COMMAND="codex"
export DEV_AI_REVIEW_COMMAND=""
# Optional. Falls back to DEV_AI_REVIEW_COMMAND when empty.
export DEV_AI_RESUME_COMMAND=""

# Positive maximum number of diff lines included in generated AI context.
export DEV_CONTEXT_MAX_LINES="4000"

# Maximum number of recent projects and worktrees shown by resume.
export DEV_RESUME_LIMIT="10"

# Default TODO priority: p0 (critical), p1 (high), p2 (medium), p3 (low).
export DEV_TODO_DEFAULT_PRIORITY="p2"

# Optional explicit default branch, e.g. main or origin/main.
# export DEV_MAIN_BRANCH="main"
